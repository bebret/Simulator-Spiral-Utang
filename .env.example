# Contoh konfigurasi. Salin menjadi .env lalu ganti password.
# File .env TIDAK di-commit (lihat .gitignore).

POSTGRES_USER=appuser
POSTGRES_PASSWORD=change_me
POSTGRES_DB=debtsim
DB_HOST=db
DB_PORT=5432

# Aturan simulasi (boleh diubah tanpa menyentuh kode)
LOAN_ADMIN_FEE_PCT=20
DAILY_INTEREST_PCT=1
MAX_TOTAL_DEBT=5000000
LOAN_OPTIONS=500000,1000000,2000000
BET_WIN_PROB=0.40
BET_PAYOUT_MULT=2
MAX_ADVANCE_DAYS=30
